{
  "name": "psya_client",
  "version": "5.5.28",
  "description": "Psya is an innovative platform for designing, conducting, and analyzing psychological assessments. With its simple, intuitive, and integrated user interface, it enables the creation of interactive online forms and the generation of accurate, personalized reports.",
  "keywords": [
    "psychology",
    "assessment",
    "nextjs",
    "react",
    "form",
    "uppy",
    "mui"
  ],
  "homepage": "https://psya.mresalat.ir/",
  "author": "FARDUP (https://mresalat.ir/)",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+http://gitlab.fardup.ir/fardup/psya_client"
  },
  "bugs": {
    "url": "http://gitlab.fardup.ir/fardup/psya_client/issues"
  },
  "scripts": {
    "dev": "next dev -p 80",
    "dev:https": "next dev -p 443 --experimental-https",
    "build": "next build --turbo",
    "build:analyze": "ANALYZE=true next build --turbo",
    "start": "next start",
    "deploy": "sh ./deploy.sh",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "barrel": "barrelsby -F -c .barrelsby.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .next out dist",
    "clean:all": "rm -rf .next out dist node_modules .pnpm-store"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.5.0",
    "@mui/x-charts": "^8.29.2",
    "@tanstack/react-query": "^5.102.0",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@uppy/core": "^4.5.3",
    "@uppy/dashboard": "^4.4.3",
    "@uppy/drag-drop": "^4.2.2",
    "@uppy/file-input": "^4.2.2",
    "@uppy/image-editor": "^3.4.2",
    "@uppy/locales": "^4.8.4",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^4.5.2",
    "@uppy/tus": "^4.3.2",
    "axios": "^1.19.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "got": "^15.1.0",
    "mime": "^4.1.0",
    "moment-jalaali": "^0.10.5",
    "next": "^16",
    "next-auth": "^4.24.15",
    "nextjs-toploader": "^3.9.17",
    "pino": "^10.3.1",
    "react": "^19",
    "react-auth-code-input": "^3.2.1",
    "react-countdown": "^2.3.6",
    "react-countup": "^6.5.3",
    "react-dom": "^19",
    "react-hook-form": "^7.86.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.0",
    "react-multi-date-picker": "^4.5.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/moment-jalaali": "^0.7.9",
    "@types/node": "^22",
    "@types/react": "^19",

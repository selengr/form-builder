{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "allowJs": true,

    "baseUrl": ".",

    "esModuleInterop": true,
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "isolatedModules": true,

    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"],
      "@actions/*": ["./actions/*"],
      "#a/*": ["src/actions/*"],
      "#c/*": ["src/components/*"],
      "#cfg/*": ["src/config/*"],
      "#h/*": ["src/hooks/*"],
      "#l/*": ["src/lib/*"],
      "#s/*": ["src/services/*"],
      "#sc/*": ["src/schemas/*"],
      "#t/*": ["src/types/*"],
      "#u/*": ["src/utils/*"]
    },

    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "exclude": ["node_modules"],
  "include": [
    "next-env.d.ts",
    "next-auth.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ]
}
